---
// 교시 페이지 틀. 학습목표·결과 확인·산출물은 course.yaml에서 자동 표시한다(ADR-003).
import BaseLayout from './BaseLayout.astro';
import LocationBar from '../components/LocationBar.astro';
import LessonNav from '../components/LessonNav.astro';
import InstructorNotes from '../components/InstructorNotes.astro';
import { checkTexts } from '../lib/course';
import type { Lesson } from '../lib/types';

interface Props {
  lesson: Lesson;
  /** 준비 중 페이지: 학습목표·산출물만 보여 준다. */
  placeholder?: boolean;
}

const { lesson, placeholder = false } = Astro.props;
---

<BaseLayout title={lesson.title} currentLessonId={lesson.id}>
  <LocationBar lesson={lesson} />
  <h1>{lesson.title}</h1>

  {placeholder && <p class="notice">이 교시는 준비 중입니다.</p>}

  <section class="lesson-summary" aria-labelledby="objectives">
    <h2 id="objectives">학습목표</h2>
    <ul>
      {lesson.objectives.map((objective) => <li>{objective.text}</li>)}
    </ul>
  </section>

  {!placeholder && <slot />}

  {
    !placeholder && (
      <section class="lesson-summary" aria-labelledby="checks">
        <h2 id="checks">결과 확인</h2>
        <ul>
          {checkTexts(lesson).map((check) => (
            <li>{check}</li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="lesson-summary" aria-labelledby="outputs">
    <h2 id="outputs">산출물</h2>
    <ul>
      {lesson.outputs.map((output) => <li>{output.text}</li>)}
    </ul>
  </section>

  {!placeholder && <InstructorNotes lesson={lesson} />}

  <LessonNav lessonId={lesson.id} />
</BaseLayout>
